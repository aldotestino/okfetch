{
  "name": "@okfetch/root",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "build:watch": "tsdown --watch",
    "changeset": "changeset",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky",
    "release": "bun run build && changeset publish",
    "version-packages": "changeset version && bun install"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@types/bun": "1.4.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "tsdown": "0.22.14",
    "ultracite": "7.2.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
