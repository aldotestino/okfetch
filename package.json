{
  "name": "@okfetch/root",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "changeset": "changeset",
    "docs:build": "bun run --cwd apps/docs build",
    "docs:dev": "bun run --cwd apps/docs dev",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "release": "bun run build && changeset publish",
    "test:types": "tstyche",
    "typecheck": "tsc --noEmit",
    "typecheck:compat": "bun run build && bunx --package typescript@5.4.5 tsc --project tests/typescript-compat/tsconfig.json",
    "version-packages": "changeset version && bun install"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/bun": "1.4.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "0.22.14",
    "tstyche": "7.2.3",
    "typescript": "7.0.2"
  }
}
